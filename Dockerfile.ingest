# Base image nội bộ (cùng registry cm-dashboard dùng cho stage sync_data).
# Cần npm install: api/email-track.js + api/fb-ingest.js ghi MySQL nội bộ qua
# lib/db-client (mysql2) khi set MYSQL_*; không set thì fallback Supabase như cũ.
FROM gitlab-nhs.shb.com.vn:5050/omnichannel/omni-devops/ci-template/node:20-alpine-amd

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev

COPY api ./api
COPY lib ./lib
COPY server ./server

EXPOSE 3001
CMD ["node", "server/ingest-server.js"]
