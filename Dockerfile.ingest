# Base image nội bộ (cùng registry cm-dashboard dùng cho stage sync_data).
# Không cần npm install: api/email-track.js + api/fb-ingest.js chỉ dùng Node builtin
# (https, url) — không require lib/db-client (chỉ 3 file *-dashboard.js cần mysql2).
FROM gitlab-nhs.shb.com.vn:5050/omnichannel/omni-devops/ci-template/node:20-alpine-amd

WORKDIR /app
COPY api ./api
COPY server ./server

EXPOSE 3001
CMD ["node", "server/ingest-server.js"]
