# SHB Facebook Dashboard — biến môi trường (đặt trên Vercel Project Settings)

# ── Facebook Graph API ──────────────────────────────────────────────────
GRAPH_VERSION=v21.0                 # ⚠️ chỉnh cho khớp version đang dùng (vd v23.0)
FB_PAGE_ID=                         # ID của Fanpage
FB_PAGE_TOKEN=                      # Page long-lived access token
                                    # quyền: pages_read_engagement, pages_read_user_content, read_insights
FB_POST_LIMIT=50                    # số bài mỗi lần fetch

# Tên metric Insights (VÙNG BIẾN ĐỘNG — xác nhận với Graph reference sau 15/06/2026)
# Lõi reactions/comments/shares KHÔNG cần khai báo (lấy bằng edge expansion, ổn định).
FB_INSIGHT_METRICS=post_impressions_unique,post_clicks

# ── Supabase (môi trường ngoài / Vercel — giai đoạn chạy song song §7 Giai đoạn 3) ──
SUPABASE_URL=                       # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=               # service_role key (chỉ dùng server-side)
EMAIL_SUPABASE_URL=                 # Supabase Email (tách khỏi Facebook), fallback về SUPABASE_URL nếu để trống
EMAIL_SUPABASE_SERVICE_KEY=
INGEST_SECRET=                      # header x-ingest-secret cho api/fb-ingest.js (userscript)

# ── MySQL nội bộ SHB (EKS — KE_HOACH_MIGRATION.md §6 câu 1) ──────────────
# Set MYSQL_HOST để chuyển sync.js/ingest-server.js sang đọc/ghi DB nội bộ thay vì
# Supabase — xem lib/db-client.js. Không set thì mọi thứ chạy y như Vercel/Supabase.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=shb_cm
MYSQL_POOL_SIZE=5

# ── Ingest server nội bộ (server/ingest-server.js) ───────────────────────
INGEST_PORT=3001
