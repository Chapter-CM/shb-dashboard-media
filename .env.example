# SHB Facebook Dashboard — biến môi trường (GitLab CI/CD Variables / máy dev)
# Chỉ chứa TÊN BIẾN + placeholder — KHÔNG bao giờ điền giá trị thật vào file này.

# ── Jira (nguồn dữ liệu chính — sync.js) ─────────────────────────────────
JIRA_DOMAIN=                        # vd shbbank.atlassian.net
JIRA_EMAIL=                         # email đăng nhập Atlassian dùng để gọi API
JIRA_TOKEN=                         # Jira API token
JIRA_PROJECT=CM                     # key project Jira (vd CM, CCM...)

# ── Facebook Graph API (⚠️ DEPRECATED — không còn được code dùng, xem ghi chú) ──
# Các biến dưới đây thuộc kiến trúc CŨ (gọi trực tiếp Facebook Graph API qua Vercel).
# Hiện tại dữ liệu Facebook được thu thập qua userscript/console tool (tools/) rồi
# POST vào api/fb-ingest.js — các biến này KHÔNG còn được source code tham chiếu
# (đã rà soát bằng grep 10/08/2026). Giữ lại để không mất lịch sử configuration —
# có thể xoá hẳn sau khi xác nhận chắc chắn không quay lại luồng Graph API trực tiếp.
GRAPH_VERSION=v21.0                 # ⚠️ DEPRECATED — chỉnh cho khớp version đang dùng (vd v23.0)
FB_PAGE_ID=                         # ⚠️ DEPRECATED — ID của Fanpage
FB_PAGE_TOKEN=                      # ⚠️ DEPRECATED — Page long-lived access token
                                    #    quyền: pages_read_engagement, pages_read_user_content, read_insights
FB_POST_LIMIT=50                    # ⚠️ DEPRECATED — số bài mỗi lần fetch
FB_INSIGHT_METRICS=post_impressions_unique,post_clicks   # ⚠️ DEPRECATED

# ── Facebook ingest (luồng hiện tại — api/fb-ingest.js, tools/) ──────────
FB_GROUP_ID=                        # ID Group Facebook (vd "SHB Một Nhà")

# ── Supabase (môi trường ngoài / Vercel — giai đoạn chạy song song §7 Giai đoạn 3) ──
SUPABASE_URL=                       # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=               # service_role key (chỉ dùng server-side)
EMAIL_SUPABASE_URL=                 # Supabase Email (tách khỏi Facebook), fallback về SUPABASE_URL nếu để trống
EMAIL_SUPABASE_SERVICE_KEY=
INGEST_SECRET=                      # header x-ingest-secret cho api/fb-ingest.js (userscript/console tool)

# ── MySQL nội bộ SHB (EKS — KE_HOACH_MIGRATION.md §6 câu 1) ──────────────
# Set MYSQL_HOST để chuyển sync.js/ingest-server.js sang đọc/ghi DB nội bộ thay vì
# Supabase — xem lib/db-client.js. Không set thì mọi thứ chạy y như Vercel/Supabase.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=shb_cm
MYSQL_POOL_SIZE=5

# ── Ingest server nội bộ (server/ingest-server.js) ───────────────────────
INGEST_PORT=3001
INGEST_API_URL=                     # URL proxy /dbquery của ingest service (dùng khi GitLab runner bị chặn kết nối thẳng RDS) — xem lib/db-client.js
SERVER_PORT=                        # port thay thế cho server nội bộ (nếu khác INGEST_PORT)
SEED_TOKEN=                         # bảo vệ scripts/seed-email-demo.js (chặn gọi seed từ bên ngoài)

# ── Email tracker (api/email-*.js) ────────────────────────────────────────
EMAIL_DWELL_CAP_S=                  # giới hạn (giây) thời gian dwell tối đa tính cho 1 email — chặn số ảo do tab mở quên
EMAIL_EVENTS_LIMIT=                 # giới hạn số event Email lấy về mỗi lần truy vấn dashboard
EVENTS_LIMIT=                       # giới hạn số event chung (dùng ở nhiều dashboard)
